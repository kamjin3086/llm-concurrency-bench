[Unit]
Description=BenchRoom local LLM benchmark web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/llm-concurrency-bench
ExecStart=/usr/bin/env python3 -m backend.server --host 0.0.0.0 --port 8790
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
